# iCal feed URLs from Booking.com and Airbnb listing calendars.
# Server-side only (fetched from the /api/availability route to avoid CORS).
ICAL_BOOKING_URL=
ICAL_AIRBNB_URL=

# Calendari per camera (Booking.com e Airbnb). SLUG = EUROPA, ASIA, AFRICA, AMERICHE, OCEANIA.
# Una camera risulta occupata se lo è la camera stessa oppure la casa intera (ICAL_*_URL sopra);
# la casa intera risulta occupata se lo è lei oppure una qualsiasi camera.
# ICAL_BOOKING_URL_ASIA=
# ICAL_AIRBNB_URL_ASIA=

# Public links to the listing pages, used by the "Prenota su..." buttons.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_AIRBNB_URL=

# Link per camera ai pulsanti "Prenota su...": se mancano, per quella camera resta solo WhatsApp.
# NEXT_PUBLIC_BOOKING_URL_ASIA=
# NEXT_PUBLIC_AIRBNB_URL_ASIA=
# (stesso schema per EUROPA, AFRICA, AMERICHE, OCEANIA; i link senza suffisso sono quelli della casa intera)

# Contacts, shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Optional: only needed if a custom-styled Google Maps embed (paid API key)
# replaces the free iframe embed used by default.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_SRC=

# Numero da chiamare dalla barra mobile (se vuoto si usa il numero WhatsApp)
NEXT_PUBLIC_PHONE_NUMBER=
# Codice Identificativo Nazionale della struttura (obbligatorio per legge negli annunci) e P. IVA, mostrati nel footer
NEXT_PUBLIC_CIN=
NEXT_PUBLIC_VAT_NUMBER=
# Codice Identificativo Regionale (Lazio)
NEXT_PUBLIC_CIR=

# Meta Pixel (dataset "Pixel Dimora Pangea"). Si carica solo con il consenso "Marketing" nel banner cookie.
# Se vuoto si usa l'ID di default nel codice.
NEXT_PUBLIC_META_PIXEL_ID=
