# iCal feed URLs from Booking.com and Airbnb listing calendars.
# Server-side only (fetched from the /api/availability route to avoid CORS).
ICAL_BOOKING_URL=
ICAL_AIRBNB_URL=

# Public links to the listing pages, used by the "Prenota su..." buttons.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_AIRBNB_URL=

# Contacts, shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Optional: only needed if a custom-styled Google Maps embed (paid API key)
# replaces the free iframe embed used by default.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_SRC=

# Numero da chiamare dalla barra mobile (se vuoto si usa il numero WhatsApp)
NEXT_PUBLIC_PHONE_NUMBER=
# Codice Identificativo Nazionale della struttura (obbligatorio per legge negli annunci) e P. IVA, mostrati nel footer
NEXT_PUBLIC_CIN=
NEXT_PUBLIC_VAT_NUMBER=
# Codice Identificativo Regionale (Lazio)
NEXT_PUBLIC_CIR=
